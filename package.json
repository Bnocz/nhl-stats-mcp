{
  "name": "nhl-stats-mcp",
  "version": "0.1.0",
  "description": "MCP server that gives Claude (and other AI assistants) live NHL scores, standings, player stats and schedules",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "prepublishOnly": "npm run build && npm test",
    "smoke": "node scripts/smoke.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "nhl",
    "hockey",
    "claude",
    "sports",
    "stats"
  ],
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "bin": {
    "nhl-stats-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bnocz/nhl-stats-mcp.git"
  },
  "homepage": "https://github.com/bnocz/nhl-stats-mcp#readme",
  "bugs": {
    "url": "https://github.com/bnocz/nhl-stats-mcp/issues"
  },
  "author": "Bertram Nocon"
}
